{
  "manifest_version": 3,
  "name": "Vignette",
  "short_name": "Vignette",
  "version": "0.9.9",
  "description": "AI 캐릭터 채팅 답변에 NovelAI 삽화를 그려 넣어요. 여러 플랫폼 지원 · 플랫폼별/채팅별 보관 · 관리 페이지.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vignette",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.univers.chat/*",
    "https://univers.chat/*",
    "https://*.caveduck.io/*",
    "https://caveduck.io/*",
    "https://*.cvdk.io/*",
    "https://cvdk.io/*",
    "https://*.elyn.ai/*",
    "https://elyn.ai/*",
    "https://*.rofan.ai/*",
    "https://rofan.ai/*",
    "https://*.teapotchat.com/*",
    "https://teapotchat.com/*",
    "https://*.riru.ai/*",
    "https://riru.ai/*",
    "https://*.uumm.ai/*",
    "https://uumm.ai/*",
    "https://image.novelai.net/*",
    "https://api.novelai.net/*",
    "https://*.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.z.ai/*",
    "https://open.bigmodel.cn/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://api.together.xyz/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://*.univers.chat/*", "https://univers.chat/*",
        "https://*.caveduck.io/*", "https://caveduck.io/*",
        "https://*.cvdk.io/*", "https://cvdk.io/*",
        "https://*.elyn.ai/*", "https://elyn.ai/*",
        "https://*.rofan.ai/*", "https://rofan.ai/*",
        "https://*.teapotchat.com/*", "https://teapotchat.com/*",
        "https://*.riru.ai/*", "https://riru.ai/*",
        "https://*.uumm.ai/*", "https://uumm.ai/*"
      ],
      "js": ["content/loader.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Vignette 패널 열기"
    }
  },
  "options_ui": {
    "page": "manager/manager.html",
    "open_in_tab": true
  }
}
